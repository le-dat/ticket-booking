# Auth service HTTP port (aligned with API Gateway architecture)
PORT=3001

# Redis connection URL for distributed rate limiting
REDIS_URL="redis://:redis_secret_123@localhost:6379/0"

# Async PostgreSQL connection string for auth_db (asyncpg driver)
DATABASE_URL="postgresql+asyncpg://auth_user:auth_pass_secret_123@localhost:5432/auth_db"

# Secret key used to sign and decode JWT Access Tokens
JWT_SECRET="super_secret_jwt_key_ticket_booking_2026_very_long_and_secure"

# JWT signing algorithm
JWT_ALGORITHM="HS256"

# Lifetime of JWT Access Token in minutes (15 minutes)
JWT_ACCESS_EXPIRES_IN_MINUTES=15

# Lifetime of Refresh Token in days (7 days)
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Allowed Client Origins for Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting configuration (requests / seconds per client IP)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW=60
RATE_LIMIT_REFRESH_MAX=10
RATE_LIMIT_REFRESH_WINDOW=60

