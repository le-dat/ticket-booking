# App
APP_NAME=booking-service
APP_VERSION=1.0.0

# HTTP settings
HTTP_PORT=3003
HTTP_USE_PREFORK_MODE=false

# Logger
LOG_LEVEL=debug

# PostgreSQL booking_db
PG_POOL_MAX=25
PG_URL=postgres://booking_user:booking_pass_secret_123@localhost:5432/booking_db?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis_secret_123
REDIS_DB=0

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC_BOOKING_EVENTS=booking-events
KAFKA_TOPIC_PAYMENT_EVENTS=payment-events
KAFKA_CONSUMER_GROUP_ID=booking-service-payment-group
KAFKA_OUTBOX_BATCH_SIZE=20
KAFKA_OUTBOX_FLUSH_INTERVAL=1s

# Event Service gRPC
EVENT_SERVICE_GRPC_ADDR=localhost:50052

# Booking business parameters
BOOKING_HOLD_DURATION=10m
BOOKING_EXPIRY_POLL_INTERVAL=5s

# Observability
METRICS_ENABLED=true
SWAGGER_ENABLED=true
TRACING_ENABLED=false
TRACING_OTLP_ENDPOINT=localhost:4317
TRACING_OTLP_INSECURE=true
TRACING_SAMPLE_RATE=1.0
