# App
APP_NAME=event-service
APP_VERSION=1.0.0

# HTTP settings
HTTP_PORT=3002
HTTP_USE_PREFORK_MODE=false

# Logger
LOG_LEVEL=debug

# PostgreSQL
PG_POOL_MAX=25
PG_URL=postgresql://event_user:event_pass_secret_123@localhost:5432/event_db?sslmode=disable

# gRPC Server
GRPC_PORT=50052

# RMQ (nếu có dùng)
RMQ_RPC_SERVER=rpc_server
RMQ_RPC_CLIENT=rpc_client
RMQ_URL=amqp://guest:guest@localhost:5672/

# NATS (nếu có dùng)
NATS_RPC_SERVER=rpc_server
NATS_URL=nats://guest:guest@localhost:4222/

# Metrics
METRICS_ENABLED=true

# Swagger
SWAGGER_ENABLED=false

# Tracing
TRACING_ENABLED=false
TRACING_OTLP_ENDPOINT=localhost:4317
TRACING_OTLP_INSECURE=true
TRACING_SAMPLE_RATE=1.0
