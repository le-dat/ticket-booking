# Payment service HTTP port
PORT=3004
ENV=development

# Async PostgreSQL connection string for payment_db (asyncpg driver)
DATABASE_URL="postgresql+asyncpg://payment_user:payment_pass_secret_123@localhost:5432/payment_db"

# Redis connection URL for distributed locking and idempotency verification
REDIS_URL="redis://:redis_secret_123@localhost:6379/0"

# Kafka configuration for events
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TOPIC_BOOKING_EVENTS="booking-events"
KAFKA_TOPIC_PAYMENT_EVENTS="payment-events"
KAFKA_CONSUMER_GROUP_ID="payment-service-group"

# Payment Gateway Configuration
DEFAULT_PAYMENT_GATEWAY="mock"
WEBHOOK_SECRET="super_secret_webhook_key_payment_2026_very_long"
PAYMENT_RETURN_URL="http://localhost:3000/booking/payment-result"

# Stripe Gateway Configuration (Required when DEFAULT_PAYMENT_GATEWAY="stripe")
STRIPE_SECRET_KEY="sk_test_mock_secret_key_ticket_booking"
STRIPE_WEBHOOK_SECRET="whsec_mock_webhook_secret_ticket_booking"
STRIPE_CURRENCY="vnd"

# Allowed Client Origins for Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
